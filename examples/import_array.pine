i32 std_max_i32(i32 a, i32 b) {
    if (a > b) {
        return a;
    }
    return b;
}

i32 std_sum4_i32(i32 arr[4]) {
    return arr[0] + arr[1] + arr[2] + arr[3];
}

i32 std_index_i32(i32 arr[4], i32 idx) {
    return arr[idx];
}

i32 main() {
    i32 values[4];
    return std_max_i32(std_sum4_i32(values), std_index_i32(values, 0));
}
