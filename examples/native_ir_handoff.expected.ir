pine_ir 1

function add_twice -> i32
  param i32 value
  param i32 amount
  scope_begin
  decl_local i32 first
  load value
  load amount
  binary add
  store first
  decl_local i32 second
  load first
  load amount
  binary add
  store second
  load second
  return_value
  return
  scope_end
end

function main -> i32
  scope_begin
  decl_local i32 result
  const 3
  const 4
  call add_twice argc=2
  store result
  load result
  const 10
  binary gt
  jump_if_false L_else_0
  scope_begin
  load result
  const 1
  binary sub
  store result
  scope_end
  jump L_end_if_1
label L_else_0:
label L_end_if_1:
  load result
  return_value
  return
  scope_end
end

