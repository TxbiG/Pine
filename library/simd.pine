// ============================================================================
// Pine SIMD — single-file portable SIMD API
// Version: 0.1.0 (API foundation)
//
// This file intentionally contains no C headers, C intrinsics, or foreign
// function declarations. It defines portable vector values and reference
// operations in Pine.
//
// IMPORTANT COMPILER NOTE
// -----------------------
// The functions below are the semantic/reference implementation. They express
// SIMD-style lane operations, but a compiler must add native vector lowering
// to emit packed instructions (SSE/AVX on x86, NEON/SVE on ARM, and RVV on
// RISC-V). Until that compiler support is implemented, these operations are
// semantically portable but may compile to scalar instructions.
//
// API rules:
//   * Lane 0 is the first/lowest-index lane.
//   * Every operation is lane-wise unless its name says `sum` or `dot`.
//   * `maskN` lanes are booleans, not bit-pattern integers.
//   * Division, NaNs, signed zero, and overflow follow Pine scalar semantics.
//   * No alignment is required by this value-based API.
// ============================================================================

// ---------------------------------------------------------------------------
// Core vector and mask types
// ---------------------------------------------------------------------------

struct f32x4 {
    x: f32,
    y: f32,
    z: f32,
    w: f32
}

struct f64x2 {
    x: f64,
    y: f64
}

struct i32x4 {
    x: i32,
    y: i32,
    z: i32,
    w: i32
}

struct u32x4 {
    x: u32,
    y: u32,
    z: u32,
    w: u32
}

struct mask4 {
    x: bool,
    y: bool,
    z: bool,
    w: bool
}

struct mask2 {
    x: bool,
    y: bool
}

// ---------------------------------------------------------------------------
// f32x4 construction and lane access
// ---------------------------------------------------------------------------

fn f32x4_zero() -> f32x4 {
    return f32x4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
}

fn f32x4_splat(value: f32) -> f32x4 {
    return f32x4 { x: value, y: value, z: value, w: value }
}

fn f32x4_make(x: f32, y: f32, z: f32, w: f32) -> f32x4 {
    return f32x4 { x: x, y: y, z: z, w: w }
}

fn f32x4_get(value: f32x4, lane: i32) -> f32 {
    if lane == 0 { return value.x }
    if lane == 1 { return value.y }
    if lane == 2 { return value.z }
    return value.w
}

fn f32x4_with_lane(value: f32x4, lane: i32, item: f32) -> f32x4 {
    if lane == 0 { return f32x4 { x: item, y: value.y, z: value.z, w: value.w } }
    if lane == 1 { return f32x4 { x: value.x, y: item, z: value.z, w: value.w } }
    if lane == 2 { return f32x4 { x: value.x, y: value.y, z: item, w: value.w } }
    return f32x4 { x: value.x, y: value.y, z: value.z, w: item }
}

// ---------------------------------------------------------------------------
// f32x4 arithmetic
// ---------------------------------------------------------------------------

fn f32x4_add(a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
}

fn f32x4_sub(a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
}

fn f32x4_mul(a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z, w: a.w * b.w }
}

fn f32x4_div(a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 { x: a.x / b.x, y: a.y / b.y, z: a.z / b.z, w: a.w / b.w }
}

fn f32x4_neg(a: f32x4) -> f32x4 {
    return f32x4 { x: -a.x, y: -a.y, z: -a.z, w: -a.w }
}

fn f32x4_min(a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 {
        x: if a.x < b.x { a.x } else { b.x },
        y: if a.y < b.y { a.y } else { b.y },
        z: if a.z < b.z { a.z } else { b.z },
        w: if a.w < b.w { a.w } else { b.w }
    }
}

fn f32x4_max(a: f32x4, b: f32x4) -> f32x4 {
    return f32x4 {
        x: if a.x > b.x { a.x } else { b.x },
        y: if a.y > b.y { a.y } else { b.y },
        z: if a.z > b.z { a.z } else { b.z },
        w: if a.w > b.w { a.w } else { b.w }
    }
}

fn f32x4_abs(a: f32x4) -> f32x4 {
    return f32x4 {
        x: if a.x < 0.0 { -a.x } else { a.x },
        y: if a.y < 0.0 { -a.y } else { a.y },
        z: if a.z < 0.0 { -a.z } else { a.z },
        w: if a.w < 0.0 { -a.w } else { a.w }
    }
}

// ---------------------------------------------------------------------------
// f32x4 comparisons and masks
// ---------------------------------------------------------------------------

fn f32x4_eq(a: f32x4, b: f32x4) -> mask4 {
    return mask4 { x: a.x == b.x, y: a.y == b.y, z: a.z == b.z, w: a.w == b.w }
}

fn f32x4_lt(a: f32x4, b: f32x4) -> mask4 {
    return mask4 { x: a.x < b.x, y: a.y < b.y, z: a.z < b.z, w: a.w < b.w }
}

fn f32x4_le(a: f32x4, b: f32x4) -> mask4 {
    return mask4 { x: a.x <= b.x, y: a.y <= b.y, z: a.z <= b.z, w: a.w <= b.w }
}

fn f32x4_gt(a: f32x4, b: f32x4) -> mask4 {
    return mask4 { x: a.x > b.x, y: a.y > b.y, z: a.z > b.z, w: a.w > b.w }
}

fn f32x4_ge(a: f32x4, b: f32x4) -> mask4 {
    return mask4 { x: a.x >= b.x, y: a.y >= b.y, z: a.z >= b.z, w: a.w >= b.w }
}

fn mask4_all(value: mask4) -> bool {
    return value.x && value.y && value.z && value.w
}

fn mask4_any(value: mask4) -> bool {
    return value.x || value.y || value.z || value.w
}

fn mask4_none(value: mask4) -> bool {
    return !mask4_any(value)
}

fn mask4_not(value: mask4) -> mask4 {
    return mask4 { x: !value.x, y: !value.y, z: !value.z, w: !value.w }
}

fn mask4_and(a: mask4, b: mask4) -> mask4 {
    return mask4 { x: a.x && b.x, y: a.y && b.y, z: a.z && b.z, w: a.w && b.w }
}

fn mask4_or(a: mask4, b: mask4) -> mask4 {
    return mask4 { x: a.x || b.x, y: a.y || b.y, z: a.z || b.z, w: a.w || b.w }
}

fn f32x4_select(mask: mask4, yes_value: f32x4, no_value: f32x4) -> f32x4 {
    return f32x4 {
        x: if mask.x { yes_value.x } else { no_value.x },
        y: if mask.y { yes_value.y } else { no_value.y },
        z: if mask.z { yes_value.z } else { no_value.z },
        w: if mask.w { yes_value.w } else { no_value.w }
    }
}

// ---------------------------------------------------------------------------
// f32x4 reductions and geometry helpers
// ---------------------------------------------------------------------------

fn f32x4_sum(value: f32x4) -> f32 {
    return (value.x + value.y) + (value.z + value.w)
}

fn f32x4_min_element(value: f32x4) -> f32 {
    let xy = if value.x < value.y { value.x } else { value.y }
    let zw = if value.z < value.w { value.z } else { value.w }
    return if xy < zw { xy } else { zw }
}

fn f32x4_max_element(value: f32x4) -> f32 {
    let xy = if value.x > value.y { value.x } else { value.y }
    let zw = if value.z > value.w { value.z } else { value.w }
    return if xy > zw { xy } else { zw }
}

fn f32x4_dot(a: f32x4, b: f32x4) -> f32 {
    return f32x4_sum(f32x4_mul(a, b))
}

// ---------------------------------------------------------------------------
// f64x2 construction, arithmetic, comparisons, and reductions
// ---------------------------------------------------------------------------

fn f64x2_zero() -> f64x2 {
    return f64x2 { x: 0.0, y: 0.0 }
}

fn f64x2_splat(value: f64) -> f64x2 {
    return f64x2 { x: value, y: value }
}

fn f64x2_make(x: f64, y: f64) -> f64x2 {
    return f64x2 { x: x, y: y }
}

fn f64x2_add(a: f64x2, b: f64x2) -> f64x2 {
    return f64x2 { x: a.x + b.x, y: a.y + b.y }
}

fn f64x2_sub(a: f64x2, b: f64x2) -> f64x2 {
    return f64x2 { x: a.x - b.x, y: a.y - b.y }
}

fn f64x2_mul(a: f64x2, b: f64x2) -> f64x2 {
    return f64x2 { x: a.x * b.x, y: a.y * b.y }
}

fn f64x2_div(a: f64x2, b: f64x2) -> f64x2 {
    return f64x2 { x: a.x / b.x, y: a.y / b.y }
}

fn f64x2_eq(a: f64x2, b: f64x2) -> mask2 {
    return mask2 { x: a.x == b.x, y: a.y == b.y }
}

fn f64x2_lt(a: f64x2, b: f64x2) -> mask2 {
    return mask2 { x: a.x < b.x, y: a.y < b.y }
}

fn f64x2_sum(value: f64x2) -> f64 {
    return value.x + value.y
}

fn f64x2_dot(a: f64x2, b: f64x2) -> f64 {
    return f64x2_sum(f64x2_mul(a, b))
}

fn mask2_all(value: mask2) -> bool {
    return value.x && value.y
}

fn mask2_any(value: mask2) -> bool {
    return value.x || value.y
}

fn mask2_not(value: mask2) -> mask2 {
    return mask2 { x: !value.x, y: !value.y }
}

fn f64x2_select(mask: mask2, yes_value: f64x2, no_value: f64x2) -> f64x2 {
    return f64x2 {
        x: if mask.x { yes_value.x } else { no_value.x },
        y: if mask.y { yes_value.y } else { no_value.y }
    }
}

// ---------------------------------------------------------------------------
// i32x4 / u32x4 construction and integer operations
// ---------------------------------------------------------------------------

fn i32x4_zero() -> i32x4 {
    return i32x4 { x: 0, y: 0, z: 0, w: 0 }
}

fn i32x4_splat(value: i32) -> i32x4 {
    return i32x4 { x: value, y: value, z: value, w: value }
}

fn i32x4_make(x: i32, y: i32, z: i32, w: i32) -> i32x4 {
    return i32x4 { x: x, y: y, z: z, w: w }
}

fn i32x4_add(a: i32x4, b: i32x4) -> i32x4 {
    return i32x4 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
}

fn i32x4_sub(a: i32x4, b: i32x4) -> i32x4 {
    return i32x4 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
}

fn i32x4_mul(a: i32x4, b: i32x4) -> i32x4 {
    return i32x4 { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z, w: a.w * b.w }
}

fn i32x4_eq(a: i32x4, b: i32x4) -> mask4 {
    return mask4 { x: a.x == b.x, y: a.y == b.y, z: a.z == b.z, w: a.w == b.w }
}

fn i32x4_lt(a: i32x4, b: i32x4) -> mask4 {
    return mask4 { x: a.x < b.x, y: a.y < b.y, z: a.z < b.z, w: a.w < b.w }
}

fn i32x4_select(mask: mask4, yes_value: i32x4, no_value: i32x4) -> i32x4 {
    return i32x4 {
        x: if mask.x { yes_value.x } else { no_value.x },
        y: if mask.y { yes_value.y } else { no_value.y },
        z: if mask.z { yes_value.z } else { no_value.z },
        w: if mask.w { yes_value.w } else { no_value.w }
    }
}

fn u32x4_zero() -> u32x4 {
    return u32x4 { x: 0, y: 0, z: 0, w: 0 }
}

fn u32x4_splat(value: u32) -> u32x4 {
    return u32x4 { x: value, y: value, z: value, w: value }
}

fn u32x4_make(x: u32, y: u32, z: u32, w: u32) -> u32x4 {
    return u32x4 { x: x, y: y, z: z, w: w }
}

fn u32x4_add(a: u32x4, b: u32x4) -> u32x4 {
    return u32x4 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
}

fn u32x4_sub(a: u32x4, b: u32x4) -> u32x4 {
    return u32x4 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
}

fn u32x4_eq(a: u32x4, b: u32x4) -> mask4 {
    return mask4 { x: a.x == b.x, y: a.y == b.y, z: a.z == b.z, w: a.w == b.w }
}

fn u32x4_lt(a: u32x4, b: u32x4) -> mask4 {
    return mask4 { x: a.x < b.x, y: a.y < b.y, z: a.z < b.z, w: a.w < b.w }
}

// ---------------------------------------------------------------------------
// Native lowering contract for Pine compiler developers
// ---------------------------------------------------------------------------
// Keep this public API architecture-neutral. The native backend should lower
// these operation families to a vector IR before scalar expansion, then select
// target instructions:
//
//   x86-64: SSE2 baseline; SSE4.1/AVX2/AVX-512 when target features allow.
//   ARM64:  NEON baseline; SVE/SVE2 when target features and vector-length
//           semantics are available.
//   RISC-V: RVV when enabled; otherwise expand to the reference lane form.
//
// Recommended IR operations include vector.splat, vector.add/sub/mul/div,
// vector.min/max, vector.compare, vector.select, vector.reduce.add, and
// vector.load/store. Do not implement this by emitting C or using C intrinsics.
//
// Future API-compatible additions: wider lane families (f32x8/f32x16), 8/16-bit
// integer vectors, bitwise operations, shifts, gather/scatter, load/store APIs,
// saturating arithmetic, horizontal reductions, and runtime feature queries.
