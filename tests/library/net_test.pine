#import <io>
#import <net>

i32 failures = 0;

void expect(bool condition, string name) {
    if (!condition) {
        io_eprint("FAIL: ");
        io_eprintln(name);
        failures = failures + 1;
    }
}

// ---------------------------------------------------------------- TCP
void test_tcp() {
    // Single-process loopback: a connect completes against the listen backlog before accept().
    i32 listener = net_tcp_listen("127.0.0.1", 0, 4);
    expect(listener >= 0, "tcp listen");
    i32 port = net_local_port(listener);
    expect(port > 0, "ephemeral port assigned");

    // nothing waiting yet: accept with a timeout reports would-block
    expect(net_accept_timeout(listener, 50) == -1 && net_would_block(), "accept timeout");
    expect(!net_readable(listener, 0), "listener not readable with no client");

    i32 client = net_tcp_connect_timeout("127.0.0.1", port, 2000);
    expect(client >= 0, "connect with timeout");
    expect(net_readable(listener, 1000), "listener readable once a client connects");
    i32 server = net_accept_timeout(listener, 1000);
    expect(server >= 0, "accept");

    u8 addr[64];
    i32 n = net_remote_addr(server, addr);
    expect(n == 9 && addr[0] == 49 && addr[8] == 49, "remote addr is 127.0.0.1");
    expect(net_remote_port(client) == port, "client's remote port is the listener port");
    expect(net_remote_port(server) == net_local_port(client), "server sees the client's port");
    n = net_local_addr(client, addr);
    expect(n == 9, "local addr text");

    // client -> server, with peek, then an exact read
    expect(net_send_str(client, "hello pine") == 10, "send_str");
    u8 buf[64];
    net_set_timeout_ms(server, 2000);
    expect(net_readable(server, 1000), "server readable");
    i64 got = net_peek(server, buf);
    expect(got == 10 && buf[0] == 104, "peek sees data");
    got = net_recv_exact(server, buf, 5);
    expect(got == 5 && buf[0] == 104 && buf[4] == 111, "recv_exact 5");
    got = net_recv(server, buf);
    expect(got == 5 && buf[0] == 32 && buf[4] == 101, "rest of the data is still queued");

    // server -> client with a byte array and a partial length
    u8 reply[5] = [112, 111, 110, 103, 33];
    expect(net_writable(server, 1000), "server writable");
    expect(net_send(server, reply, 4) == 4, "send first 4 bytes");
    net_set_recv_timeout_ms(client, 2000);
    got = net_recv(client, buf);
    expect(got == 4 && buf[0] == 112 && buf[3] == 103, "client receives bytes");

    // receive timeout: no data -> -1 and would-block
    net_set_recv_timeout_ms(client, 100);
    expect(net_recv(client, buf) == -1 && net_would_block(), "recv timeout reports would-block");

    // non-blocking mode
    expect(net_set_nonblocking(client, true) == 0, "set nonblocking");
    expect(net_recv(client, buf) == -1 && net_would_block(), "non-blocking recv returns would-block");
    expect(net_set_nonblocking(client, false) == 0, "back to blocking");

    // options
    expect(net_set_nodelay(client, true) == 0, "nodelay");
    expect(net_set_keepalive(client, true) == 0, "keepalive");
    expect(net_set_reuseaddr(listener, true) == 0, "reuseaddr");
    expect(net_set_linger(client, true, 1) == 0, "linger");
    expect(net_set_recv_buffer(client, 65536) == 0, "recv buffer");
    expect(net_set_send_buffer(client, 65536) == 0, "send buffer");
    expect(net_set_nodelay(999, true) == -1, "option on bad handle");

    // half close: shutting down the write side shows up as end-of-stream on the peer
    expect(net_shutdown(client, NET_SHUT_WRITE) == 0, "shutdown write");
    net_set_recv_timeout_ms(server, 2000);
    expect(net_recv(server, buf) == 0, "peer sees end of stream after shutdown");
    // ... but the other direction still works
    expect(net_send_str(server, "bye") == 3, "send after peer half-close");
    got = net_recv(client, buf);
    expect(got == 3 && buf[0] == 98, "half-closed side still receives");

    net_close(client);
    net_close(server);
    net_close(listener);

    // errors
    expect(net_tcp_connect_timeout("127.0.0.1", 1, 1000) == -1, "connect to a closed port fails");
    expect(net_last_error() != 0, "error code recorded");
    u8 text[128];
    expect(net_error_text(net_last_error(), text) > 0, "error text");
    expect(net_recv(77, buf) == -1, "recv on bad handle");
    expect(net_close(77) == -1, "close bad handle");
    expect(net_tcp_connect("no-such-host.invalid", 80) == -1 && net_last_error() == -1, "unresolvable host");
}

// ---------------------------------------------------------------- IPv6
void test_ipv6() {
    i32 listener = net_tcp_listen6("::1", 0, 4);
    if (listener < 0) {
        io_println("net: IPv6 loopback unavailable, skipping");
        return;
    }
    i32 port = net_local_port(listener);
    i32 client = net_tcp_connect("::1", port);
    expect(client >= 0, "ipv6 connect");
    i32 server = net_accept_timeout(listener, 1000);
    expect(server >= 0, "ipv6 accept");
    u8 addr[64];
    expect(net_remote_addr(server, addr) == 3 && addr[0] == 58 && addr[2] == 49, "remote addr is ::1");
    net_close(client);
    net_close(server);
    net_close(listener);
}

// ---------------------------------------------------------------- UDP
void test_udp() {
    i32 a = net_udp_open("127.0.0.1", 0);
    i32 b = net_udp_open("127.0.0.1", 0);
    expect(a >= 0 && b >= 0, "udp open");
    i32 pa = net_local_port(a);
    i32 pb = net_local_port(b);
    expect(pa > 0 && pb > 0 && pa != pb, "distinct udp ports");

    u8 buf[64];
    u8 msg[4] = [100, 103, 114, 109];
    expect(net_send_to(a, "127.0.0.1", pb, msg, 4) == 4, "send_to");
    net_set_recv_timeout_ms(b, 2000);
    i64 got = net_recv_from(b, buf);
    expect(got == 4 && buf[0] == 100 && buf[3] == 109, "recv_from payload");
    expect(net_from_port() == pa, "sender port");
    u8 host[64];
    i32 n = net_from_host(host);
    expect(n == 9 && host[0] == 49, "sender host is 127.0.0.1");

    // reply to the sender
    expect(net_send_to(b, "127.0.0.1", net_from_port(), msg, 2) == 2, "reply");
    net_set_recv_timeout_ms(a, 2000);
    expect(net_recv_from(a, buf) == 2, "reply received");

    // datagrams keep their boundaries
    expect(net_send_to(a, "127.0.0.1", pb, msg, 1) == 1, "1-byte datagram");
    expect(net_send_to(a, "127.0.0.1", pb, msg, 3) == 3, "3-byte datagram");
    expect(net_recv_from(b, buf) == 1, "first datagram is 1 byte");
    expect(net_recv_from(b, buf) == 3, "second datagram is 3 bytes");

    // nothing pending: timeout, and polling agrees
    net_set_recv_timeout_ms(b, 50);
    expect(net_recv_from(b, buf) == -1 && net_would_block(), "udp recv timeout");
    expect(!net_readable(b, 0), "not readable when empty");

    // connected UDP
    i32 c = net_udp_connect("127.0.0.1", pb);
    expect(c >= 0, "udp connect");
    expect(net_send(c, msg, 2) == 2, "send on connected udp");
    expect(net_readable(b, 1000), "datagram arrived");
    expect(net_recv_from(b, buf) == 2 && net_from_port() == net_local_port(c), "connected sender port");

    // options
    expect(net_set_broadcast(a, true) == 0, "broadcast");
    expect(net_set_multicast_ttl(a, 2) == 0, "multicast ttl");
    expect(net_set_multicast_loop(a, true) == 0, "multicast loop");
    expect(net_multicast_join(a, "not-an-address") == -1, "multicast join rejects bad group");
    expect(net_set_multicast_ttl(a, 999) == -1, "multicast ttl out of range");

    net_close(a);
    net_close(b);
    net_close(c);
}

// ---------------------------------------------------------------- poll_many
void test_poll_many() {
    i32 a = net_udp_open("127.0.0.1", 0);
    i32 b = net_udp_open("127.0.0.1", 0);
    i32 socks[3];
    i32 events[3];
    i32 revents[3];
    socks[0] = a;
    socks[1] = b;
    socks[2] = 200;
    events[0] = NET_POLL_IN;
    events[1] = NET_POLL_IN;
    events[2] = NET_POLL_IN;

    expect(net_poll_many(socks, events, revents, 2, 0) == 0, "nothing ready");

    u8 msg[1] = [7];
    net_send_to(a, "127.0.0.1", net_local_port(b), msg, 1);
    expect(net_poll_many(socks, events, revents, 2, 1000) == 1, "one socket ready");
    expect(revents[0] == 0 && revents[1] == NET_POLL_IN, "ready bits per socket");

    expect(net_poll_many(socks, events, revents, 3, 0) == 2, "invalid handle counts as an event");
    expect(revents[2] == NET_POLL_INVALID, "invalid handle flagged");
    expect(net_poll_many(socks, events, revents, 4, 0) == -1, "count beyond the arrays");

    net_close(a);
    net_close(b);
}

// ---------------------------------------------------------------- names, addresses, bytes
void test_names_and_bytes() {
    expect(net_is_ipv4("192.168.0.1") && !net_is_ipv4("192.168.0.256") && !net_is_ipv4("::1"), "is_ipv4");
    expect(net_is_ipv6("::1") && net_is_ipv6("fe80::1") && !net_is_ipv6("1.2.3.4"), "is_ipv6");

    u8 out[64];
    i32 n = net_resolve("127.0.0.1", out);
    expect(n == 9 && out[0] == 49, "resolve numeric address");
    expect(net_resolve("no-such-host.invalid", out) == -1, "resolve failure");
    expect(net_hostname(out) > 0, "hostname");

    u8 b[8];
    expect(net_put_u16(b, 0, 258) == 0 && b[0] == 1 && b[1] == 2, "put_u16 big endian");
    expect(net_put_u16_le(b, 2, 258) == 0 && b[2] == 2 && b[3] == 1, "put_u16 little endian");
    expect(net_put_u32(b, 4, 16909060) == 0 && b[4] == 1 && b[5] == 2 && b[6] == 3 && b[7] == 4, "put_u32 big endian");
    expect(net_get_u16(b, 0) == 258, "get_u16");
    expect(net_get_u16_le(b, 2) == 258, "get_u16_le");
    expect(net_get_u32(b, 4) == 16909060, "get_u32");
    expect(net_get_u32_le(b, 4) == 67305985, "get_u32_le");
    expect(net_put_u32(b, 0, 4294967295) == 0 && net_get_u32(b, 0) == 4294967295, "u32 max");
    expect(net_put_u16(b, 0, 70000) == -1, "u16 value out of range");
    expect(net_put_u16(b, 7, 1) == -1, "offset out of range");
    expect(net_get_u32(b, 5) == -1, "get past the end");
}

i32 main() {
    test_tcp();
    test_ipv6();
    test_udp();
    test_poll_many();
    test_names_and_bytes();
    if (failures == 0) {
        io_println("net: all tests passed");
    }
    return failures;
}
